<?xml version="1.0" encoding="UTF-8"?>
<!--
  Copy this file as web.config to the IIS site bound to
  infyvideocallapi.infyshield.com (empty site folder is fine).

  Required on that Windows server:
  1. NestJS listening on http://127.0.0.1:5083 (npm run start:prod)
  2. IIS: URL Rewrite + Application Request Routing (ARR)
  3. IIS: WebSocket Protocol feature
  4. IIS Manager → server node → Application Request Routing Cache
     → Server Proxy Settings → Enable proxy
  5. Site binding: https + hostname infyvideocallapi.infyshield.com
-->
<configuration>
  <system.webServer>
    <webSocket enabled="true" />
    <rewrite>
      <rules>
        <rule name="NestJSReverseProxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:5083/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
