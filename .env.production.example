# Production API template — copy to `.env.production` on the server (never commit real values).
# Nest loads `.env` (see app.module.ts). Local `.env` is for development only.

PROJECT_NAME=InfysSales
PORT=5083
NODE_ENV=production

# DATABASE
DB_HOST=your-db-host
DB_PORT=1433
DB_NAME=your-db-name
DB_USER=your-db-user
DB_PASS=your-db-password
DB_TYPE=mssql

JWT_SECRET=replace-with-long-random-secret
ACCESS_TOKEN_SECRET_KEY=replace-with-long-random-secret
ACCESS_TOKEN_EXPIRED=24d
TOKEN_NOT_BEFORE_EXPIRATION=
ACCESS_TOKEN_ENCRYPTKEY=
ACCESS_TOKEN_ENCRYPTIV=

REFRESH_TOKEN_SECRET_KEY=
REFRESH_TOKEN_EXPIRED=
REFRESH_TOKEN_ENCRYPTKEY=
REFRESH_TOKEN_ENCRYPTIV=
REFRESH_TOKEN_NOT_BEFORE_EXPIRATION=

JWT_PAYLOAD_ENCRYPT=
JWT_PREFIX_AUTHORIZATION=
AUTH_JWT_SUBJECT=
AUTH_JWT_AUDIENCE=
AUTH_JWT_ISSUER=

PASSWORD_EXPIRED=24d
PASSWORD_SALT_LENGTH=10

AZURE_STORAGE_KEY=your-azure-storage-connection-string
AZURE_CONTAINER=document
AZURE_STORAGE_PATH=https://your-account.blob.core.windows.net/document

WHISPER_API_URL=http://your-whisper-host:5084

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

API_PUBLIC_URL=https://infyvideocallapi.infyshield.com
GOOGLE_CALLBACK_URL=https://infyvideocallapi.infyshield.com/auth/google/callback
FRONTEND_URL=https://meetings.infyshield.com
ALLOWED_ORIGINS=https://meetings.infyshield.com,https://infyvideocallapi.infyshield.com
